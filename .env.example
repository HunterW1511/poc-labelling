# Copiar como .env y llenar los ***. NUNCA compartir el .env real ni subirlo a Git.
# PostgreSQL
POSTGRES_USER=***
POSTGRES_PASSWORD=***
POSTGRES_DB=***
# Label Studio (admin inicial + token legacy de API; rotar con un prompt oculto, nunca pegarlo en chats)
LS_ADMIN_EMAIL=***
LS_ADMIN_PASSWORD=***
LS_API_TOKEN=***
# URLs desde el host (opcionales; por defecto 127.0.0.1:8080 y :9090)
#LS_HOST_URL=http://127.0.0.1:8080
#MOTOR_HOST_URL=http://127.0.0.1:9090
# Motor. MOTOR_DEVICE: auto | cpu | 0 | cuda:0
MOTOR_DEVICE=auto
MOTOR_PREVIAS=6
MOTOR_CACHE_MAX=8
# GPU NVIDIA: descomentar. Separador ; en Windows, : en Linux/Mac.
#COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml
#TORCH_INDEX_GPU=https://download.pytorch.org/whl/cu130
# Transporte de trabajos (P.2.5): drive (defecto) o kaggle (desde P.2.7)
#TRANSPORTE=drive
# Kaggle (P.2.6): tu usuario (no es secreto; una cuenta por persona). El API token va en ~/.kaggle/access_token
#KAGGLE_USUARIO=
# Drive para escritorio: carpeta de lotes (obligatoria); las demas, por defecto junto a ella
LOTES_DRIVE=***
#DATASETS_DRIVE=
#RUNS_DRIVE=
#ASISTENTE_DRIVE=
# Cola de trabajos del hub (P.1): SQLite en disco local, NUNCA en Drive. Defecto datos/trabajos.sqlite
#TRABAJOS_DB=
# UI (etapa E). UI_PROTEGIDOS: ids separados por coma (vacio = ninguno). EJECUTOR: colab
UI_PROTEGIDOS=
EJECUTOR=colab
